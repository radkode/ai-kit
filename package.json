{
  "name": "@radkode/ai-kit",
  "version": "0.0.0",
  "description": "Building blocks for AI agents in TypeScript apps: task definitions with wire-safe manifests, a provider-wrapped runner with schema-enforced output, two-phase token/dollar budgets, tenant-namespaced caching, metadata-only telemetry, and eval scaffolding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radkode/ai-kit.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.10.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "default": "./dist/spec/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "default": "./dist/runner/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "default": "./dist/eval/index.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory.d.ts",
      "default": "./dist/adapters/memory.js"
    },
    "./adapters/upstash": {
      "types": "./dist/adapters/upstash.d.ts",
      "default": "./dist/adapters/upstash.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "evalite",
    "release": "pnpm build && changeset publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.104",
    "ai": "^6.0.238"
  },
  "peerDependencies": {
    "@upstash/redis": ">=1.34.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.0.0",
    "@upstash/redis": "^1.35.0",
    "evalite": "^0.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
